# Cloud deployment/runtime variable names only. Do not commit populated credentials.
# Obtain provider-issued values only after resources are selected and provisioned.

# Private Mission Service runtime
SPRING_PROFILES_ACTIVE=
DATABASE_URL=
SPRING_JPA_HIBERNATE_DDL_AUTO=

# Public API Gateway; backend URLs must come from Render's Internal connection details.
MISSION_SERVICE_URL=
HAZARD_SERVICE_URL=
CORS_ALLOWED_ORIGINS=
# Set this in each Render service environment (10000 for this configuration).
PORT=

# Private Hazard Service runtime; no database or Kafka connection is used by the weather API.
OPEN_METEO_BASE_URL=
WEATHER_CONNECT_TIMEOUT=
WEATHER_READ_TIMEOUT=
WEATHER_MAX_FORECAST_HOURS=
WEATHER_MAX_ROUTE_LENGTH_KM=
WEATHER_MAX_ROUTE_SAMPLES=
WEATHER_SAMPLE_SPACING_KM=
WEATHER_WIND_SPEED_THRESHOLD_MS=
WEATHER_WIND_GUST_THRESHOLD_MS=
WEATHER_PRECIPITATION_THRESHOLD_MM_PRECEDING_HOUR=

# Future hazard-report/event pipeline only; unused by current weather assessment.
SPRING_KAFKA_BOOTSTRAP_SERVERS=
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=

# Hazard Service S3 integration (optional feature; credentials should come from
# the host's workload identity/role, not static access-key environment variables).
AWS_REGION=
S3_EVIDENCE_BUCKET=

# Frontend build-time public gateway origin; contains no secret.
VITE_API_BASE_URL=
